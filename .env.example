# Database (lokaal via docker compose)
DATABASE_URL=postgres://qbicle:qbicle@localhost:5432/qbicle

# Scanner
# DNS-over-HTTPS-resolver die DNSSEC valideert (JSON-API). Alleen gebruikt voor de DNSSEC-check.
QBICLE_DOH_URL=https://cloudflare-dns.com/dns-query
# Bestand met domeinen die niet gescand willen worden (één per regel)
QBICLE_OPTOUT_FILE=
# Uitlegpagina die in de User-Agent van de scanner staat
QBICLE_SCANNER_INFO_URL=https://qbicle.example/scanner

# API (npm run api)
# Adres van de web-app; wijzigende aanvragen moeten vanaf dit adres komen (CSRF) en links in e-mails wijzen hierheen.
QBICLE_APP_ORIGIN=http://localhost:3000
# 'uit' alleen lokaal zonder https. In productie weglaten: cookie is dan __Host-, Secure.
QBICLE_SECURE_COOKIES=uit
# 'aan' als de API achter een vertrouwde proxy/load balancer staat (IP uit X-Forwarded-For).
QBICLE_TRUST_PROXY=
# Optioneel: eigen DNS-servers voor domeinverificatie, kommagescheiden.
QBICLE_DNS_SERVERS=
PORT=8080

# Apparaatherkenning via routers (packages/devices, npm run apparaten)
# Sleutelring voor versleutelde inloggegevens: "id:<base64 32 bytes>", eerste = huidige.
# Nieuwe sleutel: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QBICLE_SECRETS_KEYS=
# Aparte, vaste sleutel (base64, 32 bytes) voor pseudonimisering van MAC-adressen van gastapparaten.
QBICLE_PSEUDONYM_KEY=
# MAC-prefixregister van de IEEE (ophalen met scripts/oui-update.sh)
QBICLE_OUI_FILE=data/oui.csv
# Kwetsbaarheidsdata (snapshots; ophalen komt in fase 4)
QBICLE_NVD_FILE=
QBICLE_KEV_FILE=
QBICLE_EPSS_FILE=
